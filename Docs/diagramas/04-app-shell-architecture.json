  "cards": [
    {
      "dot": "emerald",
      "title": "Arquitectura de Desempeño 60 FPS",
      "items": [
        "El App Shell inmutable permanece activo en memoria evitando parpadeos de pantalla (CLS = 0)",
        "Las vistas dinámicas se conmutan de forma reactiva gobernadas por currentView"
      ]
    },
    {
      "dot": "cyan",
      "title": "Aislamiento de Excepciones",
      "items": [
        "ErrorBoundary atrapa cualquier error en vistas secundarias sin tumbar el Navbar ni el marco PWA",
        "El OfflineIndicator alerta al alumno de pérdida de conectividad manteniendo disponible la interfaz"
      ]
    }
  ]
