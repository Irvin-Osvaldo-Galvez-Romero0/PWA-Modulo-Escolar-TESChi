  "cards": [
    {
      "dot": "emerald",
      "title": "Independencia del Dominio (Clean Architecture)",
      "items": [
        "El paquete domain no posee importaciones de React, Express ni navegadores web",
        "Toda lógica de cálculo de créditos y prerrequisitos es testeable de forma unitaria y aislada"
      ]
    },
    {
      "dot": "cyan",
      "title": "Inversión de Dependencias y Adaptadores",
      "items": [
        "Los adaptadores de infraestructura implementan contratos tipados definidos en application",
        "Permite alternar entre motores de almacenamiento (IDB vs LocalStorage) sin alterar las vistas"
      ]
    }
