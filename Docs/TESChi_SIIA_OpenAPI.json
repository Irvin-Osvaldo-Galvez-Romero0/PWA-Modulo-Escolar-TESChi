{
  "openapi": "3.0.3",
  "info": {
    "title": "API SIIA TESCHI",
    "version": "1.0.0",
    "description": "API para autenticacion de docentes y captura de asistencia. Use el token devuelto por login en el boton Authorize."
  },
  "servers": [
    { "url": "..", "description": "API de la aplicacion actual" }
  ],
  "tags": [
    { "name": "Autenticacion" },
    { "name": "Asistencia" }
  ],
  "paths": {
    "/login.ashx": {
      "post": {
        "tags": ["Autenticacion"],
        "summary": "Iniciar sesion",
        "description": "Valida un usuario del SIIA y devuelve un token con vigencia de 480 minutos. Se permiten hasta 5 intentos por usuario e IP cada 60 segundos.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": { "usuario": "docente", "password": "password" }
            },
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login correcto",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } }
          },
          "400": { "$ref": "#/components/responses/Error400" },
          "401": { "$ref": "#/components/responses/Error401" },
          "403": { "$ref": "#/components/responses/Error403" },
          "422": { "$ref": "#/components/responses/Error422" },
          "429": { "$ref": "#/components/responses/Error429" },
          "405": { "$ref": "#/components/responses/Error405" },
          "500": { "$ref": "#/components/responses/Error500" }
        }
      }
    },
    "/asistencia/grupos.ashx": {
      "get": {
        "tags": ["Asistencia"],
        "summary": "Listar grupos del docente",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "periodo", "in": "query", "required": false,
            "description": "Periodo escolar. Si se omite, se usa el periodo actual.",
            "schema": { "type": "string", "example": "2026-1" }
          }
        ],
        "responses": {
          "200": {
            "description": "Grupos asignados",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GruposResponse" } } }
          },
          "401": { "$ref": "#/components/responses/Error401" },
          "403": { "$ref": "#/components/responses/Error403" },
          "405": { "$ref": "#/components/responses/Error405" },
          "500": { "$ref": "#/components/responses/Error500" }
        }
      }
    },
    "/asistencia/alumnos.ashx": {
      "get": {
        "tags": ["Asistencia"],
        "summary": "Listar alumnos y asistencia",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "periodo", "in": "query", "required": false, "schema": { "type": "string", "example": "2026-1" } },
          { "name": "grupo", "in": "query", "required": true, "schema": { "type": "string", "example": "1ISC11" } },
          { "name": "idMateria", "in": "query", "required": true, "schema": { "type": "integer", "format": "int32" } },
          { "name": "fecha", "in": "query", "required": false, "description": "Formato dd/MM/yyyy.", "schema": { "type": "string", "example": "21/09/2026" } }
        ],
        "responses": {
          "200": {
            "description": "Lista de alumnos",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AlumnosResponse" } } }
          },
          "400": { "$ref": "#/components/responses/Error400" },
          "401": { "$ref": "#/components/responses/Error401" },
          "403": { "$ref": "#/components/responses/Error403" },
          "405": { "$ref": "#/components/responses/Error405" },
          "500": { "$ref": "#/components/responses/Error500" }
        }
      }
    },
    "/asistencia/guardar.ashx": {
      "post": {
        "tags": ["Asistencia"],
        "summary": "Guardar o retirar asistencia",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GuardarRequest" },
              "example": {
                "periodo": "2026-1", "grupo": "1ISC11", "idMateria": 1137,
                "matricula": "2026151001", "fecha": "21/09/2026", "asistencia": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Asistencia actualizada",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GuardarResponse" } } }
          },
          "400": { "$ref": "#/components/responses/Error400" },
          "401": { "$ref": "#/components/responses/Error401" },
          "403": { "$ref": "#/components/responses/Error403" },
          "405": { "$ref": "#/components/responses/Error405" },
          "500": { "$ref": "#/components/responses/Error500" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http", "scheme": "bearer",
        "description": "Pegue solamente el token devuelto por POST /login.ashx."
      }
    },
    "responses": {
      "Error400": { "description": "Solicitud invalida", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "Error401": { "description": "Token o credenciales invalidas", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "Error403": { "description": "Usuario sin acceso", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "Error422": { "description": "La solicitud es valida, pero faltan campos requeridos", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "Error429": {
        "description": "Limite de intentos excedido. Espere el numero de segundos indicado por Retry-After.",
        "headers": {
          "Retry-After": { "description": "Segundos restantes para volver a intentar.", "schema": { "type": "integer", "example": 60 } }
        },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
      },
      "Error405": { "description": "Metodo no permitido", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "Error500": { "description": "Error interno", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object", "required": ["usuario", "password"],
        "properties": {
          "usuario": { "type": "string" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "Usuario": {
        "type": "object",
        "properties": {
          "usuario": { "type": "string" }, "numUsuario": { "type": "string" },
          "nombre": { "type": "string" }, "paterno": { "type": "string" }, "materno": { "type": "string" },
          "nombreCompleto": { "type": "string" },
          "correo": { "type": "string", "format": "email", "description": "Correo registrado del usuario. Puede ser una cadena vacia si no esta capturado." },
          "tipo": { "type": "string" },
          "idArea": { "type": "integer" }, "area": { "type": "string" },
          "idCarrera": { "type": "integer" }, "tipoCarrera": { "type": "string" },
          "permisos": { "type": "string" }, "cambioPw": { "type": "integer" },
          "puedeAsistencia": { "type": "boolean" }
        }
      },
      "LoginResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/BaseResponse" },
          { "type": "object", "properties": {
            "token": { "type": "string" }, "expiraEnMinutos": { "type": "integer", "example": 480 },
            "usuario": { "$ref": "#/components/schemas/Usuario" }
          } }
        ]
      },
      "Grupo": {
        "type": "object",
        "properties": {
          "grupo": { "type": "string" }, "idMateria": { "type": "integer" },
          "clave": { "type": "string" }, "materia": { "type": "string" },
          "idCarrera": { "type": "integer" }, "carrera": { "type": "string" },
          "tipoCurso": { "type": "string" }, "totalAlumnos": { "type": "integer" }
        }
      },
      "GruposResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/BaseResponse" },
          { "type": "object", "properties": {
            "periodo": { "type": "string" }, "numProfesor": { "type": "integer" },
            "grupos": { "type": "array", "items": { "$ref": "#/components/schemas/Grupo" } }
          } }
        ]
      },
      "AlumnoAsistencia": {
        "type": "object",
        "properties": {
          "num": { "type": "integer" }, "matricula": { "type": "string" },
          "nombre": { "type": "string" }, "sexo": { "type": "string" },
          "tipoCurso": { "type": "string" }, "fecha": { "type": "string" },
          "asistencia": { "type": "boolean" }
        }
      },
      "AlumnosResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/BaseResponse" },
          { "type": "object", "properties": {
            "periodo": { "type": "string" }, "grupo": { "type": "string" },
            "idMateria": { "type": "integer" }, "fecha": { "type": "string" },
            "alumnos": { "type": "array", "items": { "$ref": "#/components/schemas/AlumnoAsistencia" } }
          } }
        ]
      },
      "GuardarRequest": {
        "type": "object", "required": ["grupo", "idMateria", "matricula", "asistencia"],
        "properties": {
          "periodo": { "type": "string" }, "grupo": { "type": "string" },
          "idMateria": { "type": "integer" }, "matricula": { "type": "string" },
          "fecha": { "type": "string", "description": "Formato dd/MM/yyyy." },
          "asistencia": { "type": "boolean" }
        }
      },
      "GuardarResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/BaseResponse" },
          { "type": "object", "properties": {
            "periodo": { "type": "string" }, "grupo": { "type": "string" },
            "idMateria": { "type": "integer" }, "matricula": { "type": "string" },
            "fecha": { "type": "string" }, "asistencia": { "type": "boolean" }
          } }
        ]
      },
      "BaseResponse": {
        "type": "object",
        "properties": { "ok": { "type": "boolean" }, "mensaje": { "type": "string" } }
      },
      "ErrorResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/BaseResponse" }
        ]
      }
    }
  }
}
